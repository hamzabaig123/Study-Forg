{
  "name": "@caffeine/template-app",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=7.0.0",
    "npm": "please use pnpm"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@dfinity/pic"
    ],
    "overrides": {
      "seroval": ">=1.5.3",
      "seroval-plugins": ">=1.5.3",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "lodash": ">=4.18.0"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix",
    "bindgen": "caffeine-bindgen --did-file ./src/backend/dist/backend.did --out-dir ./src/frontend/src --actor-interface-file --force",
    "test": "pnpm --dir src/frontend test && pnpm run test:backend",
    "test:backend": "node test/pocketic/run-backend-lane.mjs"
  },
  "devDependencies": {
    "@dfinity/pic": "^0.23.0",
    "@icp-sdk/core": "^5.3.0",
    "sharp": "^0.35.4"
  }
}
