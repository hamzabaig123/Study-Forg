# Admin tooling only — copy to .env next to these scripts and fill in.
#
# The root .gitignore covers `.env` at any depth, so this file is the only one
# that belongs in git. Nothing here is ever read by the app: every VITE_-prefixed
# value is compiled into the shipped JavaScript, which is why the database
# password and the service role key live here instead of in
# src/frontend/.env.local.
#
# Each variable below names the script that reads it. A variable that nothing
# reads is a credential that will be pasted, committed and never revoked, so
# there are deliberately none here.

# Read by e2e/apply-migration.mjs — the <ref> from https://<ref>.supabase.co
# e.g. qjoijoxmnliarlyaqmoz
SUPABASE_PROJECT_REF=

# Read by e2e/replay-sweep.mjs. The URL is the project URL and the key is the
# PUBLISHABLE one, the same pair the browser ships; copy the whole value of each
# field, a truncated publishable key is the usual reason a project answers 401
# to everything.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Read by e2e/replay-sweep.mjs (it mints and deletes the two throwaway accounts
# through the admin API). Never put it in a VITE_ variable, and never paste it
# into a chat or an issue: it bypasses row level security entirely, so in the
# wrong hands one key reads every account's data.
SUPABASE_SERVICE_ROLE_KEY=

# Read by the one-off `pg_dump` in OPERATIONS.md, and by psql if you have it.
# This machine has neither, which is why the migration goes through
# e2e/apply-migration.mjs instead. The connection string it feeds is
#   postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
# — note the database is `postgres` (single s) and the username carries the ref.
DB_PASSWORD=

# NOT here on purpose: SUPABASE_ACCESS_TOKEN.
#
# e2e/apply-migration.mjs and `supabase functions deploy` both need a personal
# access token, and it is broader than either job — it administers every project
# on the account. Pass it for the run (`SUPABASE_ACCESS_TOKEN=… node …`), keep it
# out of this file, and revoke it at
# https://supabase.com/dashboard/account/tokens when the job is done.
