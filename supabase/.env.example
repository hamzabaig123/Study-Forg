# Admin tooling only — copy to .env next to these scripts and fill in.
#
# The root .gitignore covers `.env` at any depth, so this file is the only one
# that belongs in git. Nothing here is ever read by the app: every VITE_-prefixed
# value is compiled into the shipped JavaScript, which is why the database
# password and the service role key live here instead of in
# src/frontend/.env.local.
#
# Fill in from Supabase → Project Settings → API keys (Project URL, publishable
# key) and Project Settings → Database (Connection string, encryption key).
# Copy the whole value of each field; a truncated publishable key is the usual
# reason a project answers 401 to everything.

# e.g. qjoijoxmnliarlyaqmoz
SUPABASE_PROJECT_REF=

# Full connection string, exactly as the dashboard prints it. Two things worth
# checking when you paste it: the database is named `postgres` (single s), and
# the username for the pooled hosts is `postgres.<project-ref>`, not `postgres`.
#
#   direct   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   pooled   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Use the session pooler (5432) for pg_dump and pg_restore. The transaction
# pooler (6543) breaks them: it cannot hold the prepared statement and advisory
# locks a dump needs for its whole duration.
SUPABASE_DB_URL=

# Only needed if you script auth admin calls. Never put it in a VITE_ variable,
# and never paste it into a chat or an issue: it bypasses row level security
# entirely, so in the wrong hands one key reads every account's data.
SUPABASE_SERVICE_ROLE_KEY=

# Where backup.sh writes. Created if missing.
SUPABASE_BACKUP_DIR=./backups

# How many dumps backup.sh keeps before deleting the oldest.
SUPABASE_BACKUP_KEEP=7
