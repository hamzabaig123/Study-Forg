# Admin tooling only. Copy to .env (git-ignored) and fill in.
#
# Nothing here reaches the browser: the app reads VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY from src/frontend/.env.local instead. A value in this
# file prefixed VITE_ would be compiled into the shipped JavaScript, which is
# exactly why the DB password and the service role key live here and not there.

# Project ref, e.g. qjoijoxmnliarlyaqmoz
PROJECT_REF=

# The postgres role's password, from Project Settings → Database.
DB_PASSWORD=

# Session pooler (direct). Port 5432, single connection, right for pg_dump.
# The transaction pooler on port 6543 is for the app, not for admin tooling: it
# cannot hold a prepared statement for the length of a restore.
DB_HOST=db.qjoijoxmnliarlyaqmoz.supabase.co
DB_PORT=5432
DB_NAME=postgres

# Where `backup.sh` writes dumps.
BACKUP_DIR=./backups
