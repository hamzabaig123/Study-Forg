{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --dir src/frontend build",
  "outputDirectory": "src/frontend/dist",
  "rewrites": [
    {
      "source": "/((?!_vercel/|assets/|icons/|favicon\\.ico|manifest\\.webmanifest|sw\\.js|theme-bootstrap\\.js|env\\.json|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
