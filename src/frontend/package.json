    "clsx": "^2.1.1",
    "lucide-react": "0.511.0",
    "next-themes": "~0.4.6",
    "qrcode": "^1.5.4",
    "react": "~19.1.0",
    "react-dom": "~19.1.0",
    "recharts": "^2.15.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.2",
    "zustand": "~5.0.5"
